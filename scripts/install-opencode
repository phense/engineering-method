#!/usr/bin/env python3
"""Install an owned OpenCode loader without opening user/provider configuration."""
from __future__ import annotations

import argparse
import os
from pathlib import Path
import sys

NAME = "engineering-method.js"


def require_plain_parents(path: Path) -> None:
    for parent in reversed((path, *path.parents)):
        if parent.is_symlink():
            raise ValueError(f"refusing symlinked destination directory: {parent}")
        if parent.exists() and not parent.is_dir():
            raise ValueError(f"destination parent is not a directory: {parent}")


def loader_content(source: Path) -> str:
    import json
    uri = (source / "integrations/opencode/plugin.mjs").as_uri()
    return "// Managed by Engineering Method install-opencode.\nexport { default } from " + json.dumps(uri) + ";\n"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source-root", type=Path, default=Path(__file__).resolve().parents[1],
                        help="Retained checkout or extracted package; linked, not copied.")
    default_config = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "opencode"
    parser.add_argument("--config-dir", type=Path, default=default_config,
                        help="OpenCode configuration directory (default: XDG_CONFIG_HOME/opencode).")
    parser.add_argument("--check", action="store_true", help="Describe the change without writing.")
    parser.add_argument("--uninstall", action="store_true", help="Remove only this source's exact owned loader.")
    args = parser.parse_args(argv)
    try:
        source = args.source_root.expanduser().resolve()
        # Keep lexical ancestors visible until after the symlink check.
        config = Path(os.path.abspath(args.config_dir.expanduser()))
        destination = config / "plugins" / NAME
        require_plain_parents(destination.parent)
        content = loader_content(source).encode("utf-8")
        if destination.is_symlink():
            raise ValueError(f"refusing symlinked loader: {destination}")
        exists = destination.exists()
        if exists and (not destination.is_file() or destination.read_bytes() != content):
            raise ValueError(f"refusing foreign or modified loader: {destination}")
        if args.uninstall:
            if exists and not args.check:
                destination.unlink()
            print(("Would remove " if args.check else "Removed ") + str(destination) if exists else "Not installed.")
            return 0
        for required in ("integrations/opencode/plugin.mjs", "shared/platform/opencode.md"):
            if not (source / required).is_file():
                raise ValueError(f"missing package resource: {source / required}")
        if not (source / "skills").is_dir():
            raise ValueError(f"missing skill directory: {source / 'skills'}")
        if exists:
            print(f"Already installed: {destination}")
        elif args.check:
            print(f"Would install: {destination}\nSource: {source}")
        else:
            destination.parent.mkdir(parents=True, exist_ok=True)
            require_plain_parents(destination.parent)
            # Exclusive create also refuses a concurrent creator or symlink.
            with destination.open("xb") as stream:
                stream.write(content)
            print(f"Installed: {destination}\nSource: {source}")
        return 0
    except (OSError, ValueError) as error:
        print(f"install-opencode: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
